# ====================================================================
# Bureau of Indian Standards (BIS) Intelligent Assistant
# Environment Variables Configuration Example
# ====================================================================
#
# IMPORTANT:
# - Do NOT commit real passwords or API keys to GitHub.
# - On Windows PowerShell, set the environment variables:
#     $env:DB_URL="jdbc:postgresql://localhost:5432/bis_assistant"
#     $env:DB_USERNAME="postgres"
#     $env:DB_PASSWORD="your_postgres_password"
#     $env:GEMINI_API_KEY="your_actual_gemini_api_key"
#
# - On Windows Command Prompt (CMD), set using:
#     set DB_URL=jdbc:postgresql://localhost:5432/bis_assistant
#     set DB_USERNAME=postgres
#     set DB_PASSWORD=your_postgres_password
#     set GEMINI_API_KEY=your_actual_gemini_api_key

# PostgreSQL 18 Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/bis_assistant
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Google Gemini API Key for Spring Boot Backend
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port (Default: 8080)
SERVER_PORT=8080

# Frontend Backend Proxy URL (Default: http://localhost:8080)
VITE_BACKEND_URL=http://localhost:8080
